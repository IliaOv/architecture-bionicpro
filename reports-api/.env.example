KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
REALM=reports-realm
REPORT_ROLES=prothetic_user,user,administrator

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=reports

DEFAULT_WINDOW_DAYS=30

# S3 (MinIO) — кеш готовых отчётов
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=reports

# CDN (nginx перед MinIO) — публичная раздача отчётов
CDN_PUBLIC_URL=http://localhost:8082
REPORT_URL_SECRET=change-me-report-url-secret
